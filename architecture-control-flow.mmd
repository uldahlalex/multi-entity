flowchart TD
    Client["SPA (Client)\nsends a request"]
    Controller["API layer\n(Controller)"]
    Service["Service layer\n(business logic)"]

    Client --> Controller --> Service

    Service --> Check{"Something\nwrong?"}

    Check -->|"no"| Ok["Return normal result"]
    Ok --> Resp1["Response: 200 OK\n+ data"]

    Check -->|"yes"| Throw["throw Exception"]
    Throw --> Handler["Global exception handler\n(catches it in one place)"]
    Handler --> Resp2["Response: error status code\n+ ProblemDetails (error DTO)"]

    Resp1 --> ClientHandle["Client receives response"]
    Resp2 --> ClientHandle

    ClientHandle --> Status{"Status code\nOK?"}
    Status -->|"yes"| Then[".then() / try-block\nuse the data"]
    Status -->|"no"| Catch[".catch() / catch-block\nshow the error"]

    style Throw fill:#5c1a1a,stroke:#f87171,color:#fca5a5
    style Handler fill:#4a3b0a,stroke:#facc15,color:#fde68a
    style Resp2 fill:#4a3b0a,stroke:#facc15,color:#fde68a
    style Catch fill:#5c1a1a,stroke:#f87171,color:#fca5a5
    style Ok fill:#14532d,stroke:#4ade80,color:#bbf7d0
    style Resp1 fill:#14532d,stroke:#4ade80,color:#bbf7d0
    style Then fill:#14532d,stroke:#4ade80,color:#bbf7d0
